{
  "permissions": {
    "allow": [
      "Bash(pnpm sass:build)",
      "Bash(pnpm smoke)",
      "Bash(pnpm smoke *)",
      "Bash(pnpm run *)",
      "Bash(pnpm outdated *)",
      "Bash(composer phpcs)",
      "Bash(composer phpcs *)",
      "Bash(composer phpcbf)",
      "Bash(composer phpcbf *)",
      "Bash(composer dump-autoload)",
      "Bash(composer outdated *)",
      "Bash(composer show *)",
      "Bash(vendor/bin/phpcs *)",
      "Bash(vendor/bin/phpcbf *)",
      "Bash(php vendor/bin/phpcs *)",
      "Bash(php -l *)",
      "Bash(php -v)",
      "Bash(node --check *)",
      "Bash(bash scripts/smoke.sh)",
      "Bash(bash scripts/smoke.sh *)",
      "Bash(bash .claude/skills/wp-editable-html/scripts/fetch-template-html.sh *)",
      "Bash(node .claude/skills/wp-editable-html/scripts/validate-blocks.cjs *)",
      "Bash(curl -s http://localhost:8080/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-generated.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/php-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scss-build.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
